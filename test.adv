item "Magic Key"

character "Guardian" {
    dialogue "PassQuery" {
        say "Do you wish to pass?"
        ask {
            choice "Yes" -> effect "The Guardian steps aside." scene "Castle Gate"
            choice "No" -> effect "The Guardian shakes his head and waits silently." scene "Start"
        }
    }
}

scene "Start" {
    describe "You stand at the edge of a dark forest."
    ask "What will you do?" {
        choice "Enter the forest" -> effect "You step cautiously into the forest." scene "Forest Path"
        choice "Talk to the Guardian" -> effect "You approach the Guardian." dialogue "Guardian.PassQuery"
        choice "Turn back" -> effect "You decide to return home. The End." end
    }
}

scene "Forest Path" {
    describe "The forest is quiet and unnerving."
    ask "Do you continue?" {
        choice "Yes" -> effect "You find a Magic Key." item "Magic Key"
        choice "No" -> effect "You retrace your steps back to safety." scene "Start"
    }
}

scene "Castle Gate" {
    describe "You stand before the imposing castle gates."
    ask "Do you use the key?" {
        choice "Yes" -> effect "The gates creak open, and you step inside." end
        choice "No" -> effect "You decide to leave the castle gates behind." scene "Start"
    }
}

start "Start"